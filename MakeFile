CXX = g++
CXXFLAGS = -Wall -Wextra -std=c++17
LIB_NAME = libcalculator.a
EXEC_NAME = calculatorapp

SRCS_LIB = calculator.cpp
OBJS_LIB = $(SRCS_LIB:.cpp=.o)

SRCS_APP = main.cpp
OBJS_APP = $(SRCS_APP:.cpp=.o)

all: $(EXEC_NAME)

$(LIB_NAME): $(OBJS_LIB)
	ar rcs $@ $^

$(EXEC_NAME): $(OBJS_APP) $(LIB_NAME)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS_APP) -L. -lcalculator

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f *.o $(LIB_NAME) $(EXEC_NAME)

.PHONY: all clean